# Copy to .env for local runs, or set these as secrets on your host
# (Hugging Face Spaces "Repository secrets", Fly `fly secrets set`,
# Render "Environment"). Never commit a filled-in copy.
#
# Nothing here is ever sent to the browser. The frontend only knows this
# service's public URL (VITE_TTS_API_URL in the app's own .env).

# local | elevenlabs
TTS_PROVIDER=local

# Required when TTS_PROVIDER is not "local". This is the secret that must
# stay server-side — putting it in a VITE_ variable would ship it to every
# visitor inside the JS bundle.
TTS_API_KEY=

# Voice id used when a request doesn't name one.
#   local:      a key from VOICES in tts_engine.py, e.g. not-anime-calm
#   elevenlabs: the cloned voice's id from the provider dashboard
TTS_DEFAULT_VOICE=

# Hosted-provider model. Japanese needs a multilingual model.
TTS_MODEL_ID=eleven_multilingual_v2

# Browser origins allowed to call this service, comma-separated.
TTS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,https://bunpou.app,https://www.bunpou.app

# Where synthesized audio is cached. On an ephemeral host, point this at a
# mounted volume or the cache is lost (and re-billed) on every restart.
TTS_CACHE_DIR=

# Per-IP throttle on *uncached* synthesis.
TTS_RATE_LIMIT_REQUESTS=20
TTS_RATE_LIMIT_WINDOW=60
