# Copy to .env.local for local dev, and set the same values as build-time
# variables in CI (for GitHub Pages: repository Variables, injected into the
# `npm run build` step).
#
# IMPORTANT: every VITE_ variable is inlined into the built JavaScript and is
# readable by anyone who loads the site. Only public values belong here. The
# TTS provider's API key is NOT one of them — it lives solely in the TTS
# service's own environment (see backend/tts_service/.env.example).

# Public URL of the TTS service. Leave unset in dev to use the local uvicorn
# default (http://127.0.0.1:8001). Unset in a production build means the app
# falls back to the browser's built-in speech voice.
VITE_TTS_API_URL=

# Optional: pin every utterance to one voice id (e.g. a cloned voice from the
# provider dashboard). Unset keeps the existing girl/boy voice toggle.
VITE_TTS_VOICE_ID=

# ---------------------------------------------------------------------------
# Pre-rendered audio (npm run generate:audio)
#
# The generator talks to the TTS service, not to a provider directly, so the
# API key stays server-side. These are read by the script only — they are not
# VITE_ variables and never reach the browser.
#
#   TTS_API_URL    service to render through (default http://127.0.0.1:8001)
#   TTS_VOICE_ID   voice to render in (default: the service's own default)
#
# Once rendered, public/audio/ ships with the site and the fixed vocabulary
# plays with no service running and no per-play cost.
